      "RelatedCalls": [
        {
          "Line": 83,
          "Code": "SectionRecipeGeometryError \"CSectionRecipeHollowRectangle\", sizes.GeometrySource"
        },
        {
          "Line": 256,
          "Code": "Set AxisPath = facade.ConstrainLine(faces(index).ID, shape.ID, 1#, 0#, x - B / 2# - faces(7).AxisDistance, 1#, 0#, x + B / 2# + faces(8).AxisDistance)"
        },
        {
          "Line": 261,
          "Code": "Set AxisPath = facade.ConstrainLine(faces(index).ID, shape.ID, 0#, 1#, y - H / 2# - faces(6).AxisDistance, 0#, 1#, y + H / 2# + faces(5).AxisDistance)"
        },
        {
          "Line": 266,
          "Code": "Set shape = facade.OffsetRoundedPolygon(\"Offset.\" & faces(index).ID, polygon, offset) ' Смещаем наружный контур внутрь, а контур отверстия — в бетон."
        },
        {
          "Line": 277,
          "Code": "Set AxisPath = facade.Chain(faces(index).ID, shape.ID, first, firstParameter, last, lastParameter, base = 1) ' Линия центров вдоль горизонтальной стороны со скруглениями, слева направо."
        },
        {
          "Line": 279,
          "Code": "Set AxisPath = facade.Chain(faces(index).ID, shape.ID, \"Edge.BL\", 0#, \"Edge.BL\", 1#) ' Линия центров у левой грани, снизу вверх."
        },
        {
          "Line": 281,
          "Code": "Set AxisPath = facade.Chain(faces(index).ID, shape.ID, \"Edge.TR\", 1#, \"Edge.TR\", 0#, False) ' Линия центров у правой грани, снизу вверх; обход контура обратный."
        },
        {
          "Line": 285,
          "Code": "SectionRecipeGeometryError \"CSectionRecipeHollowRectangle\", geometrySource & \"; \" & faces(index).AxisSource, \"Арматура \" & faces(index).Caption, shape"
        }
      ]
